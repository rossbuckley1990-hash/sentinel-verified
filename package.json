{
  "name": "sentinel-verified",
  "version": "1.0.0",
  "description": "Evidence-backed verification and continuity for AI coding agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sentinel": "dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE",
    "docs/THREAT-MODEL.md",
    "docs/INTEGRATIONS.md",
    "docs/CONTRACT-DISCOVERY.md",
    "docs/REPAIR-AND-REVIEW.md",
    "docs/ISOLATION.md"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "demo": "node dist/cli.js demo",
    "benchmark": "node dist/benchmark.js",
    "prepack": "npm run build",
    "benchmark:public": "node dist/public-benchmark.js",
    "benchmark:handoff": "node dist/handoff-benchmark.js --allow-local",
    "benchmark:web": "node benchmarks/web/run.mjs --allow-local"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rossbuckley1990-hash/sentinel-verified.git"
  },
  "homepage": "https://github.com/rossbuckley1990-hash/sentinel-verified#readme"
}
