{
  "schemaVersion": 1,
  "objective": "Reject malformed ages while preserving numeric eligibility and personalised greetings",
  "approvedBy": "SENTINEL controlled demonstration specification",
  "allowedPaths": [
    "src/access.ts"
  ],
  "requirements": [
    {
      "id": "reject-strings",
      "kind": "must-change",
      "description": "String ages are invalid, including numeric-looking strings",
      "module": "src/access.ts",
      "export": "isAdult",
      "cases": [
        {
          "args": [
            "00018"
          ],
          "expected": false
        }
      ],
      "invariant": {
        "argument": 0,
        "domain": "string",
        "seeds": [
          "00018",
          "99",
          "not-an-age",
          ""
        ],
        "args": [
          ""
        ],
        "expected": false
      }
    },
    {
      "id": "reject-malformed",
      "kind": "must-change",
      "description": "Reject fractional and missing ages",
      "module": "src/access.ts",
      "export": "isAdult",
      "cases": [
        {
          "args": [
            18.5
          ],
          "expected": false
        },
        {
          "args": [
            null
          ],
          "expected": false
        }
      ]
    },
    {
      "id": "valid-ages",
      "kind": "must-preserve",
      "description": "Preserve adult and child integer eligibility",
      "module": "src/access.ts",
      "export": "isAdult",
      "cases": [
        {
          "args": [
            18
          ],
          "expected": true
        },
        {
          "args": [
            42
          ],
          "expected": true
        },
        {
          "args": [
            17
          ],
          "expected": false
        }
      ]
    },
    {
      "id": "greetings",
      "kind": "must-preserve",
      "description": "Keep personalised greetings",
      "module": "src/access.ts",
      "export": "greeting",
      "cases": [
        {
          "args": [
            "Ada"
          ],
          "expected": "Hello, Ada!"
        },
        {
          "args": [
            "Lin"
          ],
          "expected": "Hello, Lin!"
        }
      ]
    }
  ],
  "probes": [
    {
      "id": "other-greeting",
      "module": "src/access.ts",
      "export": "greeting",
      "inputs": [
        [
          "Grace"
        ]
      ]
    }
  ]
}
