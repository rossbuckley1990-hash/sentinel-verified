  "requirements": [
    {"id":"reject-strings","kind":"must-change","description":"String ages are invalid, including numeric-looking strings","module":"src/access.ts","export":"isAdult","cases":[{"args":["00018"],"expected":false}],"invariant":{"argument":0,"domain":"string","seeds":["00018","99","not-an-age",""],"args":[""],"expected":false}},
    {"id":"valid-ages","kind":"must-preserve","description":"Accept adult integers; reject children and fractional ages","module":"src/access.ts","export":"isAdult","cases":[{"args":[18],"expected":true},{"args":[42],"expected":true},{"args":[17],"expected":false},{"args":[18.5],"expected":false},{"args":[null],"expected":false}]},
